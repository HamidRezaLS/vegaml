#!/bin/sh
# Refuse a force-push or a delete of main.
#
# GitHub will not protect a branch on a private repository without a paid plan, so this is the one
# place the rule can live. It is a LOCAL guard: it stops the accident -- a `git push --force` typed
# in the wrong clone -- and it stops nothing done from another machine, from the web UI, or with
# `--no-verify`. It is not branch protection and should not be mistaken for it.
#
# Enable it in a fresh clone with:  git config core.hooksPath .githooks

protected="main"
zero=$(git hash-object --stdin </dev/null | tr '[:xdigit:]' '0')

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/"$protected") ;;
        *) continue ;;
    esac

    if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: refusing to DELETE $protected." >&2
        exit 1
    fi

    if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo "pre-push: refusing to FORCE-PUSH $protected -- $remote_sha is not an ancestor of" >&2
        echo "          $local_sha, so this would discard commits already on the remote." >&2
        echo "          Rebase onto origin/$protected, or push a branch and open a pull request." >&2
        exit 1
    fi
done
exit 0
